    "monitor": "pm2 monit",
    "logs": "pm2 logs",
    "logs:error": "powershell -NoProfile -Command \"Get-Content -Path 'logs/error.log' -Encoding utf8 -Wait\"",
    "logs:performance": "powershell -NoProfile -Command \"Get-Content -Path 'logs/performance.log' -Encoding utf8 -Wait\"",
    "logs:all": "powershell -NoProfile -Command \"Get-Content -Path 'logs/all.log' -Encoding utf8 -Wait\"",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
