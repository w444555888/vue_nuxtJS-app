    "prod": "NODE_ENV=production node src/index.js",
    "prod:pm2": "pm2 start ecosystem.config.cjs",
    "prod:stop": "pm2 stop chat-backend",
    "prod:restart": "pm2 restart ecosystem.config.cjs --update-env",
